# see https://doc.nette.org/en/configuring

parameters:
	targetCurrency: EUR
	cnbRateUrl: 'https://www.cnb.cz/cs/financni-trhy/devizovy-trh/kurzy-devizoveho-trhu/kurzy-devizoveho-trhu/denni_kurz.txt'
	# Vite / local frontend origins (override in local.neon if needed)
	corsAllowedOrigins:
		- http://localhost:5173
		- http://127.0.0.1:5173
		- http://localhost:3000
		- http://127.0.0.1:3000


application:
	errorPresenter:
		4xx: Error:Error4xx
		5xx: Error:Error5xx
	mapping: App\Presentation\*\**Presenter


database:
	# Override credentials in config/local.neon (gitignored)
	dsn: 'pgsql:host=127.0.0.1;dbname=fapi_orders'
	user: fapi
	password: fapi


latte:
	strictParsing: yes
	extensions:
		- App\Presentation\Accessory\LatteExtension


assets:
	mapping:
		default:
			path: assets
			# type: vite  # Uncomment to activate Vite for asset building


di:
	export:
		parameters: no
		tags: no
