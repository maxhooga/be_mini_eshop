services:
	- App\Core\RouterFactory::createRouter
	cache.storage: Nette\Caching\Storages\FileStorage(%tempDir%)

	-
		create: App\Core\CorsHeaders(%corsAllowedOrigins%)

	-
		create: App\Model\Product\ProductRepository
		autowired: App\Model\Product\ProductRepositoryInterface

	-
		create: App\Model\Order\OrderRepository
		autowired: App\Model\Order\OrderRepositoryInterface

	-
		create: App\Model\Exchange\CnbExchangeRateService(%cnbRateUrl%)
		autowired: App\Model\Exchange\ExchangeRateProviderInterface

	-
		create: App\Model\Pricing\PriceCalculator

	orderService:
		factory: App\Model\Order\OrderService
		arguments:
			targetCurrency: %targetCurrency%


search:
	-
		in: %appDir%
		classes:
			- *Facade
			- *Factory
		exclude:
			classes:
				- App\Model\Order\OrderService
				- App\Model\Exchange\CnbExchangeRateService
